{
  "name": "@finografic/genx",
  "type": "module",
  "version": "5.54.6",
  "description": "Opinionated generator and codemod toolkit for the @finografic ecosystem.",
  "homepage": "https://github.com/finografic/genx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finografic/genx.git"
  },
  "bugs": {
    "url": "https://github.com/finografic/genx/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "finografic",
    "generator",
    "scaffold",
    "codemod",
    "cli"
  ],
  "bin": {
    "genx": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "_templates",
    "_templates/**/.npmrc",
    "_templates/**/.gitignore"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "tsdown --watch",
    "dev:cli": "NODE_ENV=development tsx src/cli.ts --",
    "dev:feature": "tsx --tsconfig tsconfig.scripts.json .agents/skills/generate-new-genx-feature/new-feature.ts",
    "link": "pnpm build && pnpm add -g .",
    "unlink": "pnpm remove -g $npm_package_name",
    "build": "tsdown",
    "·········· TEMPLATES": "·················································",
    "templates:cli-core:check": "node scripts/check-cli-core-template.mjs",
    "templates:policy:check": "tsx --tsconfig tsconfig.scripts.json scripts/sync-template-policy.ts --check",
    "templates:policy:sync": "tsx --tsconfig tsconfig.scripts.json scripts/sync-template-policy.ts",
    "·········· TESTING": "···················································",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:ai-memory": "tsx scripts/smoke-ai-memory.ts",
    "smoke:workspace": "tsx --tsconfig tsconfig.scripts.json scripts/smoke-workspace.ts",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "lint:ci": "oxlint -c oxlint.config.ts --quiet",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· PUBLISH:GITHUB": "············································",
    "release:github:patch": "pnpm run release:check && pnpm version patch && git push --follow-tags",
    "release:github:minor": "pnpm run release:check && pnpm version minor && git push --follow-tags",
    "release:github:major": "pnpm run release:check && pnpm version major && git push --follow-tags",
    "release:check": "pnpm lint:fix && pnpm format:check && pnpm typecheck && pnpm templates:cli-core:check && pnpm templates:policy:check && pnpm test:run",
    "release:publish": "pnpm publish --registry https://npm.pkg.github.com",
    "·········· REGISTRIES": "················································",
    "view:registry:github": "pnpm view @finografic/genx --registry=https://npm.pkg.github.com",
    "·········· PACKAGES": "··················································",
    "update:deps-policy": "pnpm update @finografic/deps-policy --latest --config.minimumReleaseAge=0",
    "update:ai-agent-config": "pnpm update @finografic/ai-agent-config --latest && pnpm build && node dist/index.mjs upgrade --agent-docs -y",
    "update:cli-kit": "pnpm update @finografic/cli-kit --latest",
    "update:oxc-config": "pnpm update @finografic/oxc-config --latest && pnpm update oxfmt --latest && pnpm update oxlint --latest",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest",
    "update:deps:all": "pnpm update --latest",
    "·········· DOCS": "······················································",
    "docs:usage": "tsx scripts/generate-readme-usage.ts",
    "·········· UTILS": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "list:managed-repos": "tsx --tsconfig tsconfig.scripts.json scripts/list-managed-repos.ts",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "@finografic/ai-agent-config": "^0.1.1",
    "@finografic/cli-kit": "^2.0.0",
    "@finografic/core": "^0.16.1",
    "@finografic/deps-policy": "^0.26.19",
    "@google/design.md": "^0.4.0",
    "clack-tree-select": "^1.0.8",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "yaml": "^2.9.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@finografic/md-lint": "^0.16.7",
    "@finografic/oxc-config": "^2.9.1",
    "@finografic/project-scripts": "^2.0.1",
    "@types/node": "24.12.0",
    "@types/semver": "^7.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern --ignore-pattern '_templates/package-types/**'"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
